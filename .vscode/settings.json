{
    // Rust-Analyzer
    // RespOS intentionally keeps the kernel and user runtime as separate
    // Cargo projects; the repository root is not a Cargo workspace.
    "rust-analyzer.linkedProjects": [
        "${workspaceFolder}/os/Cargo.toml",
        "${workspaceFolder}/user/Cargo.toml"
    ],
    "rust-analyzer.cargo.target": "riscv64gc-unknown-none-elf",
    // Use rust-analyzer shipped with the image's Rust 1.89 toolchain. The
    // VS Code extension's standalone server requires Rust 1.94 or newer.
    "rust-analyzer.server.path": "/root/.rustup/toolchains/nightly-2025-05-20-x86_64-unknown-linux-gnu/bin/rust-analyzer",
    "rust-analyzer.cargo.cfgs": [
        "rust_analyzer"
    ],
    // lwext4's build script recreates a CMake directory inside vendor/.
    // Do not let background IDE work race a foreground make build there.
    "rust-analyzer.cargo.targetDir": true,
    "rust-analyzer.cargo.buildScripts.enable": false,
    "rust-analyzer.procMacro.enable": false,
    // "rust-analyzer.cargo.features": "all",
    // "rust-analyzer.cargo.target": "loongarch64-unknown-none",
    "rust-analyzer.cargo.allTargets": false,
    "rust-analyzer.check.allTargets": false,
    "rust-analyzer.checkOnSave": false,
    // The standalone analyzer currently emits internal inference errors on
    // this no_std cross-target crate. Rustc diagnostics come from make.
    "rust-analyzer.diagnostics.enable": false,
    "[rust]": {
        "editor.defaultFormatter": "rust-lang.rust-analyzer",
        "editor.formatOnSave": true
    },
    "json.schemaDownload.enable": false,
    "makefile.configureOnOpen": false,
    "terminal.integrated.env.linux": {
        "TZ": "Asia/Shanghai"
    }
}
